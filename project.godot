;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Teanga+"
run/main_scene="uid://ck1k70hnq8rx3"
config/features=PackedStringArray("4.5", "Mobile")
config/icon="res://assets/icon/icon.svg"

[autoload]

Global="*res://scripts/global.gd"

[debug]

